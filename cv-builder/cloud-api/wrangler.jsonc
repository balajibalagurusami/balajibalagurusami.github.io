{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-builder-cloud-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://balajibalagurusami.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cv-builder-users",
      "database_id": "REPLACE_WITH_YOUR_ACTUAL_D1_DATABASE_UUID",
      "migrations_dir": "migrations"
    }
  ]
}